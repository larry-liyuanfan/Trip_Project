{
  "dataset_version": "week5_instruction_candidates_v1",
  "seed": 20260802,
  "paths": {
    "businesses": "data/yelp/interim/business.parquet",
    "photos": "data/yelp/interim/photos.parquet",
    "weak_pairs": "data/yelp/processed/weak_pairs_denoised.parquet",
    "exclusion_manifests": [
      "data/eval/registry/evaluation_exclusion_manifest.jsonl",
      "data/eval/registry/evaluation_exclusion_manifest_v2.jsonl"
    ],
    "output_dir": "outputs/week5_qwen3_vl_4b"
  },
  "targets": {
    "image_product_search": 50000,
    "after_sales": 20000,
    "itinerary_planning": 10000,
    "dialogues": 10000
  },
  "sampling": {
    "product_quotas": {"hotel": 200, "attraction": 800, "restaurant": 49000}
  },
  "final_minimums": {
    "image_product_search": 45000,
    "after_sales": 18000,
    "itinerary_planning": 9000,
    "dialogues": 9000
  },
  "schemas": {
    "image_product_search": "configs/evaluation/schemas/image_product_search_v1.schema.json",
    "after_sales": "configs/evaluation/schemas/after_sales_v1.schema.json",
    "itinerary_planning": "configs/evaluation/schemas/itinerary_planning_v2.schema.json",
    "dialogue": "configs/week5/schemas/multimodal_dialogue_v2.schema.json"
  },
  "prompt_versions": {
    "image_product_search": "standardized_v2",
    "after_sales": "fewshot_4_v2",
    "itinerary_planning": "standardized_v4"
  },
  "runtime": {
    "model_config": "configs/model_qwen3_vl_4b_gpu.yaml",
    "inference_config": "configs/inference_qwen3_vl_4b_gpu.yaml",
    "itinerary_inference_config": "configs/inference_qwen3_vl_4b_itinerary_gpu.yaml",
    "base_url": "http://127.0.0.1:18001/v1",
    "timeout_seconds": 240,
    "concurrency": 4
  },
  "quality": {
    "mode": "single_operator_minimal_review_v1",
    "operator_count": 1,
    "core_scenarios": ["after_sales", "itinerary_planning"],
    "core_cross_review_rate": 0.005,
    "general_cross_review_rate": 0.002,
    "core_audit_rate": 0.001,
    "general_audit_rate": 0.0005,
    "selection_strategy": "nested_sample_id_sha256_v1",
    "self_review_mode": "inline_human_confirmation",
    "cross_review_mode": "same_operator_blind_second_pass",
    "distinct_review_session_required": true,
    "bad_case_categories": [
      "classification_error",
      "schema_or_required_field_error",
      "format_error",
      "severity_error",
      "constraint_omission"
    ]
  }
}
