{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multimodal_dialogue_v2.schema.json",
  "title": "Week 5 OTA Multimodal Dialogue v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dialogue_id",
    "scenario",
    "image_resources",
    "turns",
    "source_sample_ids",
    "generation",
    "human_review",
    "qc"
  ],
  "properties": {
    "schema_version": {"const": "multimodal_dialogue_v2"},
    "dialogue_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "scenario": {"type": "string", "enum": ["image_search", "itinerary", "after_sales"]},
    "image_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "path", "sha256"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1, "maxLength": 40},
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 6,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content", "image_refs"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 1000},
          "image_refs": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 40}
          }
        }
      }
    },
    "source_sample_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "model_name", "prompt_version"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "model_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "checks"],
      "properties": {
        "status": {"type": "string", "enum": ["awaiting_human_annotation", "partial", "accepted", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "checks": {"type": "object"}
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "issues"],
      "properties": {
        "status": {"type": "string", "enum": ["partial", "accepted", "rework", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
