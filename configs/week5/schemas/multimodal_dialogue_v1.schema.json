{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multimodal_dialogue_v1.schema.json",
  "title": "Week 5 OTA Multimodal Dialogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dialogue_id", "scenario", "images", "messages"],
  "properties": {
    "dialogue_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "scenario": {
      "type": "string",
      "enum": ["image_search_consultation", "itinerary_iteration", "after_sales_negotiation"]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "path", "sha256"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1, "maxLength": 40},
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content", "image_refs"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 1000},
          "image_refs": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 40}
          }
        }
      }
    }
  }
}
