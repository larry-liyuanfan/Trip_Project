# Week 5 受限 pilot 使用已批准的 Qwen3-VL 4B；端口仍只绑定回环地址。
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
MODEL_NAME=Qwen/Qwen3-VL-4B-Instruct
SERVED_MODEL_NAME=Qwen3-VL-4B-Instruct

# Keep model weights and Hugging Face metadata on the mounted data disk.
HF_HOME=/data/huggingface

# Bind only to loopback. Access the service through an SSH tunnel.
VLLM_BIND_ADDRESS=127.0.0.1
VLLM_HOST_PORT=8001

# Conservative single-A10 defaults for the first link validation.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.75
VLLM_LIMIT_IMAGES=1
